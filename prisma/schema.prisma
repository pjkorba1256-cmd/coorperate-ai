datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  
  analyses        Analysis[]
  reports         Report[]
  recommendations Recommendation[]
  chatHistory     ChatHistory[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ChatHistory {
  id        String   @id @default(cuid())
  role      String   // 'user' or 'assistant'
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Analysis {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  companyName     String
  industry        String
  companySize     String
  revenue         String?
  businessGoals   String?
  datasetUrl      String?  
  
  readinessScore  Float?
  roiForecast     Float?
  costReduction   Float?
  maturityLevel   String?
  predictedBenefit Float?
  boardroomReport  String?
  shapFeatures     Json?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Recommendation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title       String
  description String
  impact      String   
  effort      String   
  category    String   
  
  createdAt   DateTime @default(now())
}

model Report {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title       String
  summary     String
  pdfUrl      String?
  csvUrl      String?
  
  createdAt   DateTime @default(now())
}
